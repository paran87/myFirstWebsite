# Public (non-secret) build-time settings for the production build. NEXT_PUBLIC_*
# values are inlined by `next build`, so they must exist when Cloudflare builds.
# Update these when the Workers move to custom domains.
NEXT_PUBLIC_SITE_NAME=Walk Metro Manila
NEXT_PUBLIC_SITE_URL=https://myfirstwebsite-frontend.bragz87.workers.dev
NEXT_PUBLIC_ADMIN_URL=https://myfirstwebsite.bragz87.workers.dev
NEXT_PUBLIC_API_URL=https://myfirstwebsite.bragz87.workers.dev/api
# Set when the R2 bucket has a public custom domain; empty = files come from the backend Worker.
NEXT_PUBLIC_MEDIA_URL=
