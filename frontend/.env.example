# =====================================================================
# Frontend (public) app — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already in .gitignore).
# =====================================================================

# Backend API base URL. In development this points at the backend app's
# local port; in production point it at your deployed backend domain.
# Never hard-code localhost in a production build.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this frontend app (used for metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the admin app (the "Admin" button in the header links here).
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000

# Branding — change the site name here without touching code.
NEXT_PUBLIC_SITE_NAME=Walk Metro Manila

# Show the local PhilHealth sample clip from /public/samples/ on the homepage (set to false to hide).
NEXT_PUBLIC_SHOW_SAMPLE_VIDEOS=true

# Public URL of the R2 bucket that holds the videos and photos (a custom
# domain on the bucket, e.g. https://media.example.com). Leave empty if the
# files are served through the admin Worker (<backend>/api/files/...).
NEXT_PUBLIC_MEDIA_URL=

# Shared secret the admin backend uses to tell this site to refresh its
# cache after an edit (POST /api/revalidate). Use the SAME long random value
# in both projects (a Worker secret in production: `wrangler secret put REVALIDATE_SECRET`). Without it, edits appear after ~30 seconds instead.
REVALIDATE_SECRET=change-me-to-a-long-random-string
