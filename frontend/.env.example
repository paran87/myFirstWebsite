# =====================================================================
# Frontend (public) app — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already in .gitignore).
# =====================================================================

# Backend API base URL. In development this points at the backend app's
# local port; in production point it at your deployed backend domain.
# Never hard-code localhost in a production build.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this frontend app (used for metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the admin app (the "Admin" button in the header links here).
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000

# Branding — change the site name here without touching code.
NEXT_PUBLIC_SITE_NAME=Walk Metro Manila

# --- Supabase (optional; only needed if you later add direct
#     client-side reads instead of going through the backend API) -------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
