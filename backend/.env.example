# =====================================================================
# Backend / Admin app — local development settings (non-secret)
# Copy to `.env.local`. Secrets go in `.dev.vars` (see .dev.vars.example).
# In production these are `vars` in wrangler.jsonc; secrets use
# `wrangler secret put`. NEVER commit `.env.local` or `.dev.vars`.
# =====================================================================

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Walk Metro Manila

# --- Upload limits (MB) ---------------------------------------------------
VIDEO_MAX_FILE_SIZE_MB=2048
THUMBNAIL_MAX_FILE_SIZE_MB=10
PHOTO_MAX_FILE_SIZE_MB=20
PHOTO_MAX_BATCH_COUNT=30
# Public copies so the admin UI can show accurate hints client-side.
NEXT_PUBLIC_VIDEO_MAX_FILE_SIZE_MB=2048
NEXT_PUBLIC_THUMBNAIL_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_PHOTO_MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_PHOTO_MAX_BATCH_COUNT=30

# --- Storage ----------------------------------------------------------------
# Public URL of the R2 bucket (custom domain). Leave empty locally: files are
# then served by this app at /api/files/*.
R2_PUBLIC_URL=

# --- CORS / cache refresh ---------------------------------------------------
# Origin(s) of the public site allowed to call the public read endpoints.
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000
# After an admin change, ask the public site to refresh its cache. Needs
# REVALIDATE_SECRET (in .dev.vars) to match the frontend's.
FRONTEND_URL=http://localhost:3000

# --- Admin sign-in ------------------------------------------------------------
# Locally set ADMIN_PASSWORD in .dev.vars. Cloudflare Access is optional and
# only used with a custom domain:
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=
# ADMIN_EMAILS=
