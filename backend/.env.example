# =====================================================================
# Backend / Admin app — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is already in .gitignore).
# =====================================================================

# --- Supabase -----------------------------------------------------------
# Project URL and public anon key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy anon JWT or new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: legacy service_role JWT or new secret key (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional aliases (same values as above — the app reads these too)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Storage / CDN --------------------------------------------------------
# Which storage backend is in use. Currently only "supabase" is
# implemented, but the upload API is designed so this can change later
# (e.g. "s3", "cloudflare-r2", "bunny") without touching the rest of the app.
VIDEO_STORAGE_PROVIDER=supabase
# Optional: a CDN/base URL prefix, if you front Supabase Storage (or a
# future provider) with your own CDN domain.
VIDEO_CDN_URL=

SUPABASE_VIDEO_BUCKET=videos
SUPABASE_THUMBNAIL_BUCKET=thumbnails

# --- Upload limits (MB) ---------------------------------------------------
VIDEO_MAX_FILE_SIZE_MB=2048
THUMBNAIL_MAX_FILE_SIZE_MB=10
PHOTO_MAX_FILE_SIZE_MB=20
PHOTO_MAX_BATCH_COUNT=30
# Public copies so the admin UI can show accurate hints client-side.
NEXT_PUBLIC_VIDEO_MAX_FILE_SIZE_MB=2048
NEXT_PUBLIC_THUMBNAIL_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_PHOTO_MAX_FILE_SIZE_MB=20
NEXT_PUBLIC_PHOTO_MAX_BATCH_COUNT=30

# --- CORS ------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the public
# read endpoints (GET /api/videos, /api/categories, POST .../view)
# directly from the browser.
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=Walk Metro Manila

# --- Dev-only admin login (local testing without Supabase Auth) -----------
# Never set DEV_ADMIN_LOGIN_ENABLED=true in production.
DEV_ADMIN_LOGIN_ENABLED=true
DEV_ADMIN_EMAIL=jener
DEV_ADMIN_PASSWORD=123
