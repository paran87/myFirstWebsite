# Local development secrets for `next dev` / `wrangler dev`.
# Copy to `.dev.vars` (git-ignored). In production use `wrangler secret put`.

# Admin password for /admin/login (at least 12 characters). In production this is
# a Worker secret: `wrangler secret put ADMIN_PASSWORD`.
ADMIN_PASSWORD=change-me-to-a-long-password

# Optional local shortcut that skips signing in under `next dev`. Ignored in production.
# DEV_ADMIN_EMAIL=admin@example.com

# Must equal the frontend's REVALIDATE_SECRET.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Only for direct browser -> R2 uploads of large videos (S3-compatible API).
# Create under R2 -> Manage API tokens -> "Object Read & Write" for the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
